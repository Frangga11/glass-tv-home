<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A111E"
    android:clipChildren="false">

    <!-- Layer 0: Hardware-Accelerated Dynamic Atmospheric Weather Canvas -->
    <com.gathin.tvhome.WeatherBackgroundView
        android:id="@+id/weatherBgView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Layer 1: Apple Weather Frosted Glass UI -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="44dp"
            android:paddingEnd="44dp"
            android:paddingTop="20dp"
            android:paddingBottom="24dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Top Header: Apple Weather Center Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/weatherSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="0.12"
                        android:singleLine="true"
                        android:text="LOKASI SAYA"
                        android:textAllCaps="true"
                        android:textColor="#C8DCF8"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btnChangeLocation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_location_pill"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:paddingStart="12dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="4dp"
                        android:text="📍 Tukar Stesen / Region"
                        android:textColor="#E2E8F0"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/weatherLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:singleLine="true"
                    android:text="Putrajaya"
                    android:textColor="#FFFFFF"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/weatherMainTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 700"
                    android:includeFontPadding="false"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="10"
                    android:singleLine="true"
                    android:text="26°"
                    android:textColor="#FFFFFF"
                    android:textSize="68sp" />

                <TextView
                    android:id="@+id/weatherMainCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 600"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="5"
                    android:singleLine="true"
                    android:text="Light drizzle"
                    android:textColor="#F1F5F9"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/weatherMainSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:singleLine="true"
                    android:text="H: 29°  L: 24°  •  Rasa seperti 31°"
                    android:textColor="#CBD5E1"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Hourly Forecast Obsidian Card (Apple Weather Signature) -->
            <LinearLayout
                android:id="@+id/cardHourly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/weather_card_bg"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/hourlySummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 500"
                    android:singleLine="true"
                    android:text="Keadaan mendung dan hujan dijangka berterusan hari ini. Angin bertiup 5 km/h."
                    android:textColor="#E2E8F0"
                    android:textSize="12.5sp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="8dp"
                    android:background="#18FFFFFF" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/hourlyContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:clipToPadding="false"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Bottom Modular Grid (7-Day Forecast, Air Quality, Wind & Metrics) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:baselineAligned="false"
                android:clipChildren="false"
                android:orientation="horizontal">

                <!-- Column 1: 7-DAY FORECAST Card -->
                <LinearLayout
                    android:id="@+id/cardDaily"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1.25"
                    android:background="@drawable/weather_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.08"
                            android:singleLine="true"
                            android:text="📅  7-DAY FORECAST"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="4dp"
                        android:background="#15FFFFFF" />

                    <LinearLayout
                        android:id="@+id/dailyContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>

                <!-- Column 2: AIR QUALITY Card -->
                <LinearLayout
                    android:id="@+id/cardAqi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1.0"
                    android:background="@drawable/weather_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 700"
                        android:letterSpacing="0.08"
                        android:singleLine="true"
                        android:text="🍃  AIR QUALITY"
                        android:textColor="#94A3B8"
                        android:textSize="11.5sp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="10dp"
                        android:background="#15FFFFFF" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/aqiValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:includeFontPadding="false"
                            android:text="55"
                            android:textColor="#38BDF8"
                            android:textSize="32sp" />

                        <TextView
                            android:id="@+id/aqiStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 600"
                            android:singleLine="true"
                            android:text="Moderate"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp" />
                    </LinearLayout>

                    <com.gathin.tvhome.AqiSpectrumBarView
                        android:id="@+id/aqiBar"
                        android:layout_width="match_parent"
                        android:layout_height="16dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp" />

                    <TextView
                        android:id="@+id/aqiAdvisory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 400"
                        android:lineSpacingExtra="2dp"
                        android:maxLines="3"
                        android:text="Kualiti udara memuaskan. Aktiviti luar boleh dijalankan seperti biasa."
                        android:textColor="#CBD5E1"
                        android:textSize="11.5sp" />

                    <TextView
                        android:id="@+id/aqiStation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:ellipsize="end"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:singleLine="true"
                        android:text="Stesen: SK Putrajaya Presint 18 (2)"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- Column 3: DETAILS (WIND + UV & SUNSET) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:orientation="vertical">

                    <!-- Tile 3A: WIND -->
                    <LinearLayout
                        android:id="@+id/cardWind"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/weather_card_bg"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.08"
                            android:singleLine="true"
                            android:text="💨  WIND"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="8dp"
                            android:background="#15FFFFFF" />

                        <TextView
                            android:id="@+id/windSpeedText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:text="5 km/h"
                            android:textColor="#FFFFFF"
                            android:textSize="24sp" />

                        <TextView
                            android:id="@+id/windDescText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:ellipsize="end"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 400"
                            android:singleLine="true"
                            android:text="Angin tenang • Tiupan sehingga 12 km/h"
                            android:textColor="#CBD5E1"
                            android:textSize="11.5sp" />
                    </LinearLayout>

                    <!-- Tile 3B: UV INDEX & SUNSET -->
                    <LinearLayout
                        android:id="@+id/cardMetrics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/weather_card_bg"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingTop="12dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 700"
                            android:letterSpacing="0.08"
                            android:singleLine="true"
                            android:text="☀️  UV &amp; SUNSET"
                            android:textColor="#94A3B8"
                            android:textSize="11.5sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="6dp"
                            android:layout_marginBottom="8dp"
                            android:background="#15FFFFFF" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Left: UV -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/uvValText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 700"
                                    android:text="9"
                                    android:textColor="#F59E0B"
                                    android:textSize="20sp" />

                                <TextView
                                    android:id="@+id/uvDescText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 500"
                                    android:singleLine="true"
                                    android:text="Sangat Tinggi"
                                    android:textColor="#CBD5E1"
                                    android:textSize="11sp" />
                            </LinearLayout>

                            <!-- Right: Sunset / Humidity -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/humidityValText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 700"
                                    android:text="90%"
                                    android:textColor="#38BDF8"
                                    android:textSize="20sp" />

                                <TextView
                                    android:id="@+id/sunsetText"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="@font/outfit"
                                    android:fontVariationSettings="'wght' 500"
                                    android:singleLine="true"
                                    android:text="Terbenam: 6:57 PM"
                                    android:textColor="#CBD5E1"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Footer: Source and Timestamp -->
            <TextView
                android:id="@+id/weatherFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 400"
                android:gravity="center"
                android:singleLine="true"
                android:text="Updated 10:38 AM  •  Jabatan Alam Sekitar (APIMS)  •  Open-Meteo"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
