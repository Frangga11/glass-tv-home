<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/closeAllRoot"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="24dp"
    android:layout_marginEnd="64dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Invisible placeholder matching topPill height (32dp + 12dp margin) -->
    <View
        android:layout_width="1dp"
        android:layout_height="44dp"
        android:visibility="invisible" />

    <!-- Container matching cardContainer height (170dp) so vertical center is identical -->
    <FrameLayout
        android:layout_width="140dp"
        android:layout_height="170dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- Round White Button -->
            <FrameLayout
                android:id="@+id/btnCircle"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_circle_close_all"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="true">

                <ImageView
                    android:id="@+id/ivTrash"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:contentDescription="Close All"
                    android:src="@drawable/ic_trash" />
            </FrameLayout>

            <!-- Close All Label -->
            <TextView
                android:id="@+id/tvCloseAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/outfit"
                android:text="Close All"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
