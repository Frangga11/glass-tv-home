<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nightstandRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/nightstandWallpaper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/standby_photo_description"
        android:scaleType="centerCrop"
        android:src="@drawable/standby_family_wallpaper" />

    <ImageView
        android:id="@+id/nightstandPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@string/standby_photo_description"
        android:visibility="gone" />

    <View
        android:id="@+id/nightstandPhotoScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#33000000"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/nightstandContent"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="42dp"
        android:background="@drawable/bg_standby_frosted_panel"
        android:elevation="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="8dp"
        android:paddingEnd="9dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/nightstandPrayer"
            android:layout_width="match_parent"
            android:layout_height="27dp"
            android:background="@drawable/bg_standby_metric"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="#FF172334"
            android:textSize="9sp" />

        <TextClock
            android:id="@+id/nightstandDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="#FF475569"
            android:textSize="11sp" />

        <!-- Kept hidden for MainActivity preview compatibility; the clock is intentionally centered without AM/PM. -->
        <TextView
            android:id="@+id/nightstandAmPm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView
            android:id="@+id/nightstandHijri"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 500"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/tv_ui_text_secondary"
            android:textSize="8sp" />

        <TextClock
            android:id="@+id/nightstandClock"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:gravity="center"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 700"
            android:includeFontPadding="false"
            android:letterSpacing="-0.045"
            android:shadowColor="#33000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#FF172334"
            android:textSize="48sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="3dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_standby_metric"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/nightstandWeatherIcon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans"
                    android:includeFontPadding="false"
                    android:text="☀"
                    android:textSize="18sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/nightstandWeatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 700"
                        android:includeFontPadding="false"
                        android:text="—"
                        android:textColor="#FF172334"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/nightstandWeatherRange"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 500"
                        android:includeFontPadding="false"
                        android:textColor="#FF475569"
                        android:textSize="7sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:background="@drawable/bg_standby_metric"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <TextView
                    android:id="@+id/nightstandAqiValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="AQI —"
                    android:textColor="#FF172334"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/nightstandAqiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="—"
                    android:textSize="7sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/nightstandPrayerScheduleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 700"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/standby_prayer_schedule_title"
            android:textColor="#FF172334"
            android:textSize="9sp" />

        <LinearLayout
            android:id="@+id/nightstandPrayerSchedule"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:orientation="horizontal">

            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/nightstandFajrLabel" style="@style/StandbyPrayerLabel" android:text="Subuh" />
                <TextView android:id="@+id/nightstandFajrTime" style="@style/StandbyPrayerTime" android:text="—" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="22dp" android:background="#6680C8E8" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/nightstandDhuhrLabel" style="@style/StandbyPrayerLabel" android:text="Dzuhur" />
                <TextView android:id="@+id/nightstandDhuhrTime" style="@style/StandbyPrayerTime" android:text="—" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="22dp" android:background="#6680C8E8" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/nightstandAsrLabel" style="@style/StandbyPrayerLabel" android:text="Ashar" />
                <TextView android:id="@+id/nightstandAsrTime" style="@style/StandbyPrayerTime" android:text="—" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="22dp" android:background="#6680C8E8" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/nightstandMaghribLabel" style="@style/StandbyPrayerLabel" android:text="Maghrib" />
                <TextView android:id="@+id/nightstandMaghribTime" style="@style/StandbyPrayerTime" android:text="—" />
            </LinearLayout>
            <View android:layout_width="1dp" android:layout_height="22dp" android:background="#6680C8E8" />
            <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <TextView android:id="@+id/nightstandIshaLabel" style="@style/StandbyPrayerLabel" android:text="Isya" />
                <TextView android:id="@+id/nightstandIshaTime" style="@style/StandbyPrayerTime" android:text="—" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/nightstandHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/inter"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="@string/standby_return_hint"
            android:textColor="#66475569"
            android:textSize="7sp" />
    </LinearLayout>
</FrameLayout>
