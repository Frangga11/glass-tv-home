<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:background="#FF000000">

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Top shelf: location, wallpaper title and description, positioned above the dock in code.
         The width is capped in code to a share of the space between the side paddings, so the
         description wraps in a column instead of running the width of the screen. -->
    <LinearLayout
        android:id="@+id/heroShelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="0dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroWhere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="0.18"
            android:textAllCaps="false"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:singleLine="true"
            android:visibility="gone" />

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:textColor="#FFFFFFFF"
            android:textSize="36sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 600"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="0.75"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="5"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- The wallpaper description follows the title. -->

        <TextView
            android:id="@+id/heroDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="#CCFFFFFF"
            android:textSize="14sp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 400"
            android:lineSpacingExtra="2dp"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Right shelf: Waktu Solat Table matching bravia-glass-tv UI -->
    <LinearLayout
        android:id="@+id/islamicShelf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="0dp"
        android:orientation="vertical"
        android:gravity="end"
        android:alpha="1">

        <!-- Ayat / Doa Harian (WeeklyAyah) matching bravia-glass-tv UI -->
        <LinearLayout
            android:id="@+id/ayahBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:layoutDirection="ltr"
            android:orientation="vertical"
            android:gravity="end"
            android:padding="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/ayahLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/daily_prayer_label"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 700"
                android:letterSpacing="0.14"
                android:textAllCaps="true"
                android:includeFontPadding="false"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true" />

            <TextView
                android:id="@+id/ayahArabic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxWidth="400dp"
                android:layoutDirection="ltr"
                android:gravity="end"
                android:textDirection="rtl"
                android:textColor="@color/tv_ui_text_primary"
                android:textSize="20sp"
                android:fontFamily="@font/amiri_quran"
                android:lineSpacingExtra="-2dp"
                android:lineSpacingMultiplier="0.92"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:includeFontPadding="true"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#CC000000"
                android:shadowDx="0"
                android:shadowDy="2"
                android:shadowRadius="3" />

            <TextView
                android:id="@+id/ayahText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:maxWidth="400dp"
                android:gravity="start"
                android:textDirection="ltr"
                android:textColor="#F2FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 400"
                android:lineSpacingExtra="0dp"
                android:lineSpacingMultiplier="1.04"
                android:breakStrategy="high_quality"
                android:hyphenationFrequency="none"
                android:maxLines="2"
                android:ellipsize="end"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="1.5" />

            <TextView
                android:id="@+id/ayahOpenHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:text="@string/daily_ayah_open"
                android:textColor="#FFEAF7FF"
                android:textSize="10sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 700"
                android:includeFontPadding="false" />
            <View
                android:id="@+id/prayerSectionDivider"
                android:layout_width="180dp"
                android:layout_height="1dp"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="2dp"
                android:background="#55FFFFFF"
                android:alpha="0.55" />
        </LinearLayout>

        <!-- Waktu Solat Header (e.g. WAKTU SOLAT • 11 JAMADILAWAL 1448H) -->
        <TextView
            android:id="@+id/prayerHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="0dp"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:translationY="-6dp"
            android:fontFamily="@font/inter"
            android:fontVariationSettings="'wght' 700"
            android:letterSpacing="0.12"
            android:includeFontPadding="false"
            android:shadowColor="#99000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <!-- Waktu Solat Table (6 Columns: Subuh, Syuruk, Zohor, Asar, Maghrib, Isyak) -->
        <LinearLayout
            android:id="@+id/prayerTable"
            android:translationY="-6dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="end">

            <!-- Subuh -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="0dp">
                <TextView
                    android:id="@+id/lblSubuh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prayer_subuh"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 650"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="1.5" />
                <TextView
                    android:id="@+id/timeSubuh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="2" />
            </LinearLayout>

            <!-- Syuruk -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblSyuruk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prayer_sunrise"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 650"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeSyuruk"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Zohor -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblZohor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prayer_dhuhr"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 650"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeZohor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Asar -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblAsar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prayer_asr"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 650"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeAsar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblMaghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prayer_maghrib"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 650"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeMaghrib"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>

            <!-- Isyak -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginStart="14dp">
                <TextView
                    android:id="@+id/lblIsyak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/prayer_isha"
                    android:textAllCaps="true"
                    android:textColor="#B3FFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 650"
                    android:shadowColor="#99000000"
                    android:shadowDy="1"
                    android:shadowRadius="3" />
                <TextView
                    android:id="@+id/timeIsyak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="17sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 700"
                    android:shadowColor="#B3000000"
                    android:shadowDy="1"
                    android:shadowRadius="4" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="30dp"
        android:paddingEnd="30dp"
        android:paddingTop="29dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Top Row: Clock & Date on Left, Menu Buttons on Right (SEBARIS DENGAN MASA) -->
            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="44sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 500"
                    android:letterSpacing="-0.03"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="1"
                    android:shadowRadius="4"
                    android:includeFontPadding="false" />

                <!-- Clock/date divider mirrors the location/elevation separator. -->
                <View
                    android:id="@+id/clockDateDivider"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:background="#66FFFFFF" />

                <!-- 1:2 layout: AM/PM above the date. -->
                <LinearLayout
                    android:id="@+id/dateBlock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="0dp"
                    android:orientation="vertical">

                    <!-- Atas: AM/PM (e.g. PG / PTG / MLM) -->
                    <TextView
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="0.06"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textAllCaps="true" />

                    <!-- Bawah: Tarikh (e.g. 23 OKT 2026) -->
                    <TextView
                        android:id="@+id/date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:includeFontPadding="false"
                        android:textColor="#E6FFFFFF"
                        android:textSize="14sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="0.06"
                        android:shadowColor="#80000000"
                        android:shadowDx="0"
                        android:shadowDy="1"
                        android:shadowRadius="3"
                        android:textAllCaps="true" />

                    <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                    <TextView
                        android:id="@+id/shamsiDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="14sp"
                        android:fontVariationSettings="'wght' 600"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textColor="#E6FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.02"
                        android:includeFontPadding="false"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Location pill: selected Indonesian city and altitude. -->
            <LinearLayout
                android:id="@+id/locationPill"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_below="@id/leftBlock"
                android:layout_alignParentStart="true"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:background="@drawable/header_glass_pill_bg"
                android:focusable="true"
                android:clickable="true">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_header_location"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/locationName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false" />
                <View
                    android:id="@+id/locationAltitudeDivider"
                    android:layout_width="1dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:background="#66FFFFFF" />
                <ImageView
                    android:id="@+id/locationMountainIcon"
                    android:layout_width="22dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_header_mountain"
                    android:contentDescription="@null" />
                <TextView
                    android:id="@+id/locationAltitude"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Weather and modelled AQI remain the existing G3B data provider and UI control. -->
            <TextView
                android:id="@+id/weatherAirQuality"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_below="@id/locationPill"
                android:layout_alignParentStart="true"
                android:layout_marginTop="4dp"
                android:focusable="true"
                android:clickable="true"
                android:background="@drawable/header_glass_pill_bg"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:gravity="center_vertical"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:includeFontPadding="false"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:fontFamily="@font/inter"
                android:fontVariationSettings="'wght' 500"
                android:shadowColor="#99000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:singleLine="true"
                android:ellipsize="end" />

            <!-- Now Playing Widget Card: Matching bravia-glass-tv design -->
            <LinearLayout
                android:id="@+id/nowPlayingCard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_below="@id/weatherAirQuality"
                android:layout_alignParentStart="true"
                android:layout_marginTop="12dp"
                android:focusable="false"
                android:visibility="gone"
                android:background="@drawable/glass_panel"
                android:paddingStart="12dp"
                android:paddingEnd="14dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/cardAlbumArt"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_media_app_pill"
                    android:src="@drawable/ic_music"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusRight="@+id/cardTrackInfo" />

                <LinearLayout
                    android:id="@+id/cardTrackInfo"
                    android:layout_width="190dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:orientation="vertical"
                    android:background="@drawable/bg_track_info_selector"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/cardAlbumArt"
                    android:nextFocusRight="@+id/btnInlinePrev">

                    <TextView
                        android:id="@+id/cardSubtitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/now_playing_placeholder"
                        android:textColor="#B3FFFFFF"
                        android:textSize="11sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 500"
                        android:letterSpacing="0.04"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/cardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/song_title_placeholder"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@font/inter"
                        android:fontVariationSettings="'wght' 600"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever" />
                </LinearLayout>

                <!-- Inline Media Controls: Prev, Play/Pause, Next (Round buttons with ic_np_tint) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnInlinePrev"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_previous"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/cardTrackInfo"
                        android:nextFocusRight="@+id/btnInlinePlayPause" />

                    <ImageView
                        android:id="@+id/btnInlinePlayPause"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_pause"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlinePrev"
                        android:nextFocusRight="@+id/btnInlineNext" />

                    <ImageView
                        android:id="@+id/btnInlineNext"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:padding="8dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_skip_next"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlinePlayPause"
                        android:nextFocusRight="@+id/btnInlineClose" />

                    <ImageView
                        android:id="@+id/btnInlineClose"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_close"
                        android:tint="@color/ic_np_tint"
                        android:focusable="true"
                        android:clickable="true"
                        android:background="@drawable/bg_np_round_btn"
                        android:nextFocusLeft="@+id/btnInlineNext" />
                </LinearLayout>
            </LinearLayout>

            <!-- Center navigation: fixed owner-approved order Beranda → Profil → Pengaturan. -->
            <LinearLayout
                android:id="@+id/navPill"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/header_glass_pill_bg"
                android:paddingStart="2dp"
                android:paddingEnd="2dp"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:clipChildren="false"
                android:clipToPadding="false">
                <TextView
                    android:id="@+id/btnHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:drawableStart="@drawable/ic_header_home"
                    android:drawablePadding="4dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textColor="#FFFFFFFF"
                    android:drawableTint="#FFFFFFFF"
                    android:fontVariationSettings="'wght' 600"
                    android:includeFontPadding="false"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:fontVariationSettings="'wght' 600"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:background="@android:color/transparent"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="Beranda" />
                <TextView
                    android:id="@+id/btnCandyBox"
                    style="@style/TopMenuButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginStart="0dp"
                    android:gravity="center"
                    android:drawablePadding="4dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:textSize="14sp"
                    android:fontVariationSettings="'wght' 600"
                    android:includeFontPadding="false"
                    android:textColor="#FFFFFFFF"
                    android:drawableTint="#FFFFFFFF"
                    android:text="Profil"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:drawableStart="@drawable/ic_shield_child"
                    android:contentDescription="@string/user_profile_content_description"
                    android:background="@android:color/transparent" />
                <FrameLayout
                    android:id="@+id/btnSettingsContainer"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:clipChildren="false"
                    android:clipToPadding="false">
                    <TextView
                        android:id="@+id/btnSettings"
                        style="@style/TopMenuButton"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginStart="0dp"
                        android:gravity="center"
                        android:drawablePadding="4dp"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp"
                        android:textSize="14sp"
                        android:fontVariationSettings="'wght' 600"
                        android:includeFontPadding="false"
                        android:textColor="#FFFFFFFF"
                        android:drawableTint="#FFFFFFFF"
                        android:text="@string/settings"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:contentDescription="@string/settings"
                        android:drawableStart="@drawable/ic_settings"
                        android:background="@android:color/transparent" />

                </FrameLayout>
            </LinearLayout>

            <!-- Top Menu Buttons: Wi-Fi and Assistant remain right-aligned; Inputs is unchanged. -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignTop="@id/leftBlock"
                android:layout_alignBottom="@id/leftBlock"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopMenuButton"
                    android:text="@string/inputs"
                    android:drawableStart="@drawable/ic_input" />

                <View
                    android:id="@+id/headerInputsDivider"
                    android:layout_width="1dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="2dp"
                    android:background="#66FFFFFF" />
                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopMenuButton"
                    android:layout_height="30dp"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi" />

                <TextView
                    android:id="@+id/btnAssistant"
                    style="@style/TopMenuButton"
                    android:layout_width="32dp"
                    android:layout_height="30dp"
                    android:layout_marginStart="10dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:drawablePadding="0dp"
                    android:contentDescription="@string/assistant_content_description"
                    android:drawableStart="@drawable/ic_mic" />


            </LinearLayout>

            <!-- Fallback Prayer Times view -->
            <TextView
                android:id="@+id/prayerTimes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/weatherAirQuality"
                android:layout_alignParentStart="true"
                android:visibility="gone" />
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <com.gathin.tvhome.FadeTopFrame
            android:id="@+id/gridWrap"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </com.gathin.tvhome.FadeTopFrame>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
