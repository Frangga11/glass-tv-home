<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="660dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_dialog"
    android:padding="22dp">

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_update"
            android:tint="#FFFFFFFF"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ota_support_title"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVersionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ota_version_subtitle"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/inter"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Content: 2 Columns (OTA Left, Belanja Kopi Right) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Left Column: OTA Controls -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginEnd="16dp">

            <!-- Status Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_media_app_pill"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvAutoStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ota_auto_update_active"
                    android:textColor="#FFFFFFFF"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ota_update_description"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- Buttons -->
            <TextView
                android:id="@+id/btnCheckNow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_dialog_btn"
                android:text="@string/ota_check_now"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusDown="@+id/btnChangeTime"
                android:nextFocusRight="@+id/btnClose"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/btnChangeTime"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_dialog_btn"
                android:text="@string/ota_change_time"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/btnCheckNow"
                android:nextFocusDown="@+id/btnToggleAuto"
                android:nextFocusRight="@+id/btnClose"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/btnToggleAuto"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_dialog_btn"
                android:text="@string/ota_disable"
                android:textColor="#FFFFFFFF"
                android:textSize="12.5sp"
                android:fontFamily="@font/inter"
                android:textStyle="bold"
                android:gravity="center"
                android:focusable="true"
                android:clickable="true"
                android:nextFocusUp="@+id/btnChangeTime"
                android:nextFocusDown="@+id/btnClose"
                android:nextFocusRight="@+id/btnClose" />
        </LinearLayout>

        <!-- Divider Line -->
        <View
            android:layout_width="1dp"
            android:layout_height="220dp"
            android:background="#2EFFFFFF" />

        <!-- Right Column: Belanja Kopi QR -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.9"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:layout_marginStart="16dp">

            <!-- Title & Handle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_coffee"
                    android:tint="#FFFFFFFF"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/coffee_support"
                    android:textColor="#FFFFFFFF"
                    android:textSize="14sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" @imsomangge"
                    android:textColor="#FF90B8"
                    android:textSize="13sp"
                    android:fontFamily="@font/inter"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coffee_payment_method"
                android:textColor="#80FFFFFF"
                android:textSize="11sp"
                android:fontFamily="@font/inter"
                android:layout_marginBottom="8dp" />

            <!-- QR Code Card -->
            <ImageView
                android:id="@+id/imgQrCoffee"
                android:layout_width="150dp"
                android:layout_height="185dp"
                android:src="@drawable/qr_coffee"
                android:scaleType="fitCenter"
                android:contentDescription="DuitNow QR @imsomangge" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/coffee_qr_description"
                android:textColor="#B3FFFFFF"
                android:textSize="10.5sp"
                android:fontFamily="@font/inter"
                android:layout_marginTop="6dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📧 Cadangan: ahmad.anammat@me.com"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/inter"
                android:layout_marginTop="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="14dp">

        <TextView
            android:id="@+id/btnClose"
            android:layout_width="130dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_dialog_btn"
            android:text="@string/close_label"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:fontFamily="@font/inter"
            android:textStyle="bold"
            android:gravity="center"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusUp="@+id/btnToggleAuto"
            android:nextFocusLeft="@+id/btnToggleAuto" />
    </LinearLayout>
</LinearLayout>
