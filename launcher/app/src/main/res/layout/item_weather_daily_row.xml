<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/dailyDay"
            android:layout_width="54dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 600"
            android:singleLine="true"
            android:text="Today"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <ImageView
            android:id="@+id/dailyIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/wx_sun" />

        <TextView
            android:id="@+id/dailyMinTemp"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 500"
            android:gravity="end"
            android:singleLine="true"
            android:text="24°"
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <com.gathin.tvhome.TempRangeBarView
            android:id="@+id/dailyTempBar"
            android:layout_width="0dp"
            android:layout_height="20dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/dailyMaxTemp"
            android:layout_width="30dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/outfit"
            android:fontVariationSettings="'wght' 700"
            android:gravity="start"
            android:singleLine="true"
            android:text="29°"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <View
        android:id="@+id/dailyDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#15FFFFFF" />
</LinearLayout>
