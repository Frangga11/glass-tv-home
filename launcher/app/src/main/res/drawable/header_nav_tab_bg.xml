<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_ui_disabled_surface" />
            <stroke android:width="1dp" android:color="@color/tv_ui_disabled_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Focus is painted on the tab surface: above the shared capsule, below its label. -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#35DCE5ED" />
            <stroke android:width="1dp" android:color="@color/tv_ui_focus_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#26343F4A" />
            <stroke android:width="1dp" android:color="@color/tv_ui_focus_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#24DCE5ED" />
            <stroke android:width="1dp" android:color="#55DCE5ED" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
