<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33465360" />
            <stroke android:width="2dp" android:color="@color/tv_ui_focus_cyan" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#55465360" />
            <stroke android:width="1dp" android:color="@color/tv_ui_focus_cyan" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#55DCE5ED" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
