<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_ui_disabled_surface" />
            <stroke android:width="1dp" android:color="@color/tv_ui_disabled_border" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#334C5C68" />
            <stroke android:width="1dp" android:color="@color/tv_ui_focus_border" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#2600E5FF" />
            <stroke android:width="2dp" android:color="@color/tv_ui_focus_border" />
            <corners android:radius="13dp" />
        </shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
