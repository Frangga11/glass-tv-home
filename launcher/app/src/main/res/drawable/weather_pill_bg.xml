<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_ui_surface_focused" />
            <stroke android:width="2dp" android:color="@color/tv_ui_focus_cyan" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_ui_surface" />
            <stroke android:width="1dp" android:color="@color/tv_ui_border" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
