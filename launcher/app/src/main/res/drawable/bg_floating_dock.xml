<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#5C77838F"
                android:centerColor="#4A56616D"
                android:endColor="#5C77838F" />
            <corners android:radius="28dp" />
            <stroke android:width="1.2dp" android:color="#80E2E8EE" />
        </shape>
    </item>
    <item android:bottom="80dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#24FFFFFF"
                android:endColor="#00000000" />
            <corners android:topLeftRadius="28dp" android:topRightRadius="28dp" />
        </shape>
    </item>
</layer-list>
