<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/tv_ui_disabled_surface" />
            <stroke android:width="1dp" android:color="@color/tv_ui_disabled_border" />
            
            
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="#55465360" />
            <stroke android:width="1dp" android:color="@color/tv_ui_focus_cyan" />
            
            
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="#55434F5B" />
            <stroke android:width="2dp" android:color="@color/tv_ui_focus_cyan" />
            
            
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="#24FFFFFF" />
            <stroke android:width="1dp" android:color="#66DCE5ED" />
            
            
        </shape>
    </item>
</selector>
