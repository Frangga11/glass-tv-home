<?xml version="1.0" encoding="utf-8"?>
<!-- Opaque fallback for surfaces where cached wallpaper glass is unavailable or disabled. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#D936414B" />
            <stroke android:width="1dp" android:color="#80DCE5ED" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</layer-list>
