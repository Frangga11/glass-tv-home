<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#263F4B56" />
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#FF00E5FF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4DDCE5ED" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#99DCE5ED" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#24FFFFFF" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#66DCE5ED" />
        </shape>
    </item>
</selector>
